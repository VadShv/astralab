# PostgreSQL (managed Cloud.ru or any Postgres). Replace with your connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/astra_recruiting?schema=public"

# 32-byte hex key for encrypting provider API keys at rest (AES-256-GCM).
# Generate with: bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left empty, the app auto-generates and persists a key to .encryption-key
# (gitignored) on first run — fine for dev, but set this explicitly in production.
ENCRYPTION_KEY=""

# Default provider seeded on first run (Cloud.ru Foundation Models, OpenAI-compatible).
DEFAULT_PROVIDER_NAME="Cloud.ru"
DEFAULT_PROVIDER_BASE_URL="https://foundation-models.api.cloud.ru/v1"
DEFAULT_PROVIDER_API_KEY=""
DEFAULT_MODEL_ID=""

# ── Auth (next-auth) ──
# Generate with: bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3070"
# Set to "false" to enforce real authentication (require login).
# Any other value (or unset) keeps demo mode (no login needed).
ALLOW_DEMO="true"
# Optional OAuth providers (leave empty to disable)
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_ID=""
GOOGLE_SECRET=""
